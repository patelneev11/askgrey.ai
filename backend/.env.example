ENVIRONMENT=development
DATABASE_URL=sqlite:///./askgrey.db
# Any environment other than `development` refuses to start with this placeholder or with
# fewer than 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-every-deployed-environment
CORS_ORIGINS=http://localhost:5173

# Corporate SSO (leave blank to disable the SSO entry point)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback

# NCBI Entrez. A key raises the PubMed rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
NCBI_TOOL_NAME=askgrey
NCBI_CONTACT_EMAIL=
NCBI_TIMEOUT_SECONDS=20

# PubChem PUG-REST. No key exists; the limit is 5 requests/second per IP.
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBCHEM_TIMEOUT_SECONDS=20
PUBCHEM_RATE_LIMIT=5
PUBCHEM_MAX_CANDIDATES=10

# ClinicalTrials.gov v2. No key exists; the limit is self-imposed politeness.
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_TIMEOUT_SECONDS=20
CLINICALTRIALS_RATE_LIMIT=5
CLINICALTRIALS_PAGE_SIZE=25

# Natural-language -> Entrez translation via Claude. Without a key the rule-based
# translator is used.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
