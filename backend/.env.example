ENVIRONMENT=development
# SQLite is for local work only. Any other environment refuses to start on a SQLite file,
# because a container's filesystem is replaced on deploy and the stored paper bytes live here.
# A provider's `postgres://` or `postgresql://` URL can be pasted unchanged.
DATABASE_URL=sqlite:///./askgrey.db
# Connection pool for a network database; ignored by SQLite.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
# Any environment other than `development` refuses to start with this placeholder or with
# fewer than 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-every-deployed-environment
CORS_ORIGINS=http://localhost:5173
# Absolute path to a built frontend to serve from this process (single-origin deployment).
# Defaults to backend/static when that directory holds an index.html.
FRONTEND_DIST_DIR=

# Corporate SSO (leave blank to disable the SSO entry point)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback

# NCBI Entrez. A key raises the PubMed rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
NCBI_TOOL_NAME=askgrey
NCBI_CONTACT_EMAIL=
NCBI_TIMEOUT_SECONDS=20

# PubChem PUG-REST. No key exists; the limit is 5 requests/second per IP.
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBCHEM_TIMEOUT_SECONDS=20
PUBCHEM_RATE_LIMIT=5
PUBCHEM_MAX_CANDIDATES=10

# ClinicalTrials.gov v2. No key exists; the limit is self-imposed politeness.
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_TIMEOUT_SECONDS=20
CLINICALTRIALS_RATE_LIMIT=5
CLINICALTRIALS_PAGE_SIZE=25

# USPTO Open Data Portal patent search. A free key is mandatory; with none, the patent
# landscape endpoint reports the source as unavailable instead of searching.
USPTO_ODP_BASE_URL=https://api.uspto.gov/api/v1
USPTO_ODP_API_KEY=
USPTO_ODP_TIMEOUT_SECONDS=20
USPTO_ODP_RATE_LIMIT=2

# Natural-language -> Entrez translation via Claude. Without a key the rule-based
# translator is used.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
# Hard ceiling on Claude calls per account per day.
LLM_DAILY_CALL_BUDGET=250
# Metered token spend that triggers one WARNING line per day. 0 disables the alert.
LLM_DAILY_COST_ALERT_USD=25

# Development only. Replaces the preclinical narrative drafter with a fixture that writes
# deliberately wrong numbers, so the discrepancy audit's flagged view can be seen through the
# running app; the app refuses to start with it set outside the development environment.
REGULATORY_FIXTURE_DRAFTER=false

# Stored paper bytes are encrypted by the app before they reach the database. Base64, 32 bytes
# decoded; generate one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Left blank, the key is derived from JWT_SECRET, which keeps a clone runnable but makes every
# stored paper unreadable (and so dropped, then re-addable) if that secret is rotated. Allowed
# in development only: outside it, one of this and DOCUMENT_KMS_KEY_ID is required at boot.
DOCUMENT_ENCRYPTION_KEY=
# Preferred in AWS: envelope encryption under a KMS key. Each document gets its own data key,
# minted by KMS and stored only wrapped, so the master key never enters this process, rotates
# without re-encrypting anything, and every read of a stored paper is a CloudTrail record. Takes
# a key id, ARN or alias (e.g. alias/askgrey-documents); the task role needs kms:GenerateDataKey
# and kms:Decrypt on it. Costs one KMS call per store and per read.
DOCUMENT_KMS_KEY_ID=
# Region for the KMS client. Blank uses the ambient AWS configuration, which is what an ECS
# task or an instance profile already provides.
AWS_REGION=
# How long a stored paper is kept before it is deleted, enforced on every read and write.
DOCUMENT_RETENTION_DAYS=90
# How long security audit events are kept, and the ceiling per account. This is what the Audit
# Trails tab reports; it is not a 21 CFR Part 11 retention scheme.
AUDIT_RETENTION_DAYS=365
AUDIT_MAX_EVENTS_PER_USER=2000

# Reverse proxies in front of the app, counted from the app outwards. 0 trusts only the peer
# address; set 1 behind Railway's edge so the per-source-address limits key on the visitor
# rather than on the proxy. Never set it higher than the number of proxies you control.
TRUSTED_PROXY_HOPS=0

# Observability. With no DSN, error reporting is a no-op, which is how dev and CI run.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
RELEASE=dev
LOG_LEVEL=INFO
# JSON in every deployed environment; set false locally if you would rather read the lines.
LOG_JSON=true

# Single-origin deployment: point this at the built SPA (frontend/dist) to serve it from the
# API process. Leave empty to serve only the API and host the frontend separately.
FRONTEND_DIST_DIR=
