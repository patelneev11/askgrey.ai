# Blank means "same origin", which is what the single-origin deployment and the dev proxy use.
VITE_API_URL=

# Error tracking. With no DSN the frontend logs to the console only, which is how dev runs.
# This value ships to the browser: a DSN is public by design, so never put a token here.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
VITE_RELEASE=dev
